+    def reference_context_score(reference_file: str, asset: Asset) -> int:
+        ref_parts = list(PurePosixPath(norm_path(reference_file)).parent.parts)
+        anchor = asset.atlas_plist if asset.kind == 'atlas_frame' and asset.atlas_plist else asset.source_path
+        asset_parts = list(PurePosixPath(norm_path(anchor)).parent.parts)
+        score = 0
+        for left, right in zip(ref_parts, asset_parts):
+            if left.lower() != right.lower():
+                break
+            score += 1
+        if ref_parts == asset_parts:
+            score += 10
+        return score
+
+    def narrow_ids_for_reference(reference_file: str, ids: tuple[str, ...]) -> tuple[str, ...]:
+        if len(ids) <= 1:
+            return ids
+        scored = [(reference_context_score(reference_file, asset_by_id[aid]), aid) for aid in ids]
+        best = max(score for score, _aid in scored)
+        # Two shared path segments (normally assets/package or res/drawable) establish
+        # useful local context. Exact-directory matches receive +10.
+        if best >= 2:
+            narrowed = tuple(aid for score, aid in scored if score == best)
+            if narrowed:
+                return narrowed
+        return ids
